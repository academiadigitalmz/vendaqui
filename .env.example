# URL base da API (sem barra no fim). Por omissão usa /api no mesmo domínio.
VITE_API_URL=/api
# true = respostas simuladas no browser (MSW). Ponha false quando o backend estiver pronto.
VITE_USE_MOCKS=true
# Visual por omissão: academia | cakto | cakto-laranja
VITE_DEFAULT_SKIN=cakto
# false esconde o botão "Áreas do protótipo"
VITE_SHOW_SWITCHER=true
