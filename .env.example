# URL base da API (sem barra no fim). Por omissão usa /api no mesmo domínio.
VITE_API_URL=/api
# Destino usado apenas pelo proxy do Vite em desenvolvimento.
API_PROXY_TARGET=http://localhost:8080
# Visual por omissão: academia | cakto | cakto-laranja
VITE_DEFAULT_SKIN=cakto
# O switcher visual existe apenas para desenvolvimento e é opt-in.
VITE_SHOW_SWITCHER=false
